# PostgreSQL superuser password
POSTGRES_PASSWORD=postgres

# Migration role password
MIGRATION_PASSWORD=migration_pass

# Publication role password
PUBLICATION_PASSWORD=publication_pass

# Runtime role password
RUNTIME_PASSWORD=runtime_pass

# JWT signing key (HS256, minimum 32 bytes)
COURSE_JWT_SIGNING_KEY=ThisIsALocalDevSigningKeyAtLeast32Bytes!

# Worker role password
WORKER_PASSWORD=worker_pass